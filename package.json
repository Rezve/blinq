{
  "name": "blinq",
  "version": "1.1.1",
  "description": "Desktop app that reminds you to take breaks at configurable intervals.",
  "main": "./out/main/index.js",
  "author": "blinq",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "predist": "npm version patch --no-git-tag-version",
    "dist": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:mac": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release": "node scripts/bump-version.mjs && npm run release:retry",
    "release:retry": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false node --env-file=.env node_modules/electron-builder/cli.js --win --publish always && node --env-file=.env scripts/release-notes.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
